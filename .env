APP_NAME="Kravan Pictures"
APP_ENV=production
APP_DEBUG=true
APP_URL=https://kravan-api-1.onrender.com
APP_MAINTENANCE_DRIVER=file
APP_KEY=base64:e1GAo+3QmL2S4S1OKOf/bKwyBgs+73+BfdyIH9Rl8TE=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================
# DATABASE (Aiven MySQL)
# =============================
DB_CONNECTION=mysql
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12424
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your-aiven-password-here
MYSQL_ATTR_SSL_CA=/var/www/html/ca.pem

# =============================
# SESSION & CACHE
# =============================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.kravanpictures.com

CACHE_STORE=file
CACHE_DRIVER=file

# =============================
# SANCTUM / CORS
# =============================
SANCTUM_STATEFUL_DOMAINS=kravanpictures.com,kravan-pictures.vercel.app,localhost:3000,localhost:5173
FRONTEND_URL=https://kravanpictures.com

# =============================
# QUEUE
# =============================
QUEUE_CONNECTION=sync

# =============================
# BROADCAST / FILESYSTEM
# =============================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================
# MAIL
# =============================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@kravanpictures.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"